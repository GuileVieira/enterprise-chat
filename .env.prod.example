# Orqest production env for Coolify.
# Copy these values into Coolify environment variables or a server-side .env.
# Replace every CHANGE_ME value before first deploy.

HOST=0.0.0.0
PORT=3080
NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=6144

DOMAIN_CLIENT=https://orquest.redbytesolutions.com.br
DOMAIN_SERVER=https://orquest.redbytesolutions.com.br
CONFIG_PATH=/app/config/librechat.prod.yaml
TRUST_PROXY=1
NO_INDEX=true
CONSOLE_JSON=true
DEBUG_LOGGING=false
DEBUG_CONSOLE=false

MONGO_URI=mongodb://mongodb:27017/LibreChat
MONGO_AUTO_INDEX=false
MONGO_AUTO_CREATE=true

SEARCH=true
MEILI_NO_ANALYTICS=true
MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=CHANGE_ME_HEX_32_OR_LONGER

RAG_PORT=8000
RAG_API_URL=http://rag_api:8000
RAG_OPENAI_BASEURL=https://openrouter.ai/api/v1
RAG_OPENAI_API_KEY=CHANGE_ME_RAG_OPENAI_OR_OPENROUTER_KEY
RAG_USE_FULL_CONTEXT=false
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=openai/text-embedding-3-small

POSTGRES_DB=orqest_rag
POSTGRES_USER=orqest
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=false
ALLOW_SOCIAL_REGISTRATION=false
ALLOW_PASSWORD_RESET=false
ALLOW_UNVERIFIED_EMAIL_LOGIN=true

SESSION_EXPIRY=1000 * 60 * 15
REFRESH_TOKEN_EXPIRY=(1000 * 60 * 60 * 24) * 7
JWT_SECRET=CHANGE_ME_OPENSSL_RAND_HEX_32
JWT_REFRESH_SECRET=CHANGE_ME_OPENSSL_RAND_HEX_32
CREDS_KEY=CHANGE_ME_OPENSSL_RAND_HEX_32
CREDS_IV=CHANGE_ME_OPENSSL_RAND_HEX_16

APP_TITLE=Orqest
ENDPOINTS=agents,custom

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_KEY=
ASSISTANTS_API_KEY=
OPENROUTER_KEY=
FLUX_API_BASE_URL=https://api.us1.bfl.ai
